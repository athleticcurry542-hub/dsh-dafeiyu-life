{
  "name": "dsh-dafeiyu-life",
  "version": "2.4.87",
  "description": "大肥鱼 · DSH 生活系统：让大肥鱼自主刷 B站、理解字幕与热评、自然互动、形成经历、记住主人和朋友，并把重要生活状态长期持久化。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dafeiyu",
    "bilibili",
    "memory",
    "agent-companion",
    "persistent-agent",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minedalang/dsh-dafeiyu-life.git"
  },
  "homepage": "https://github.com/minedalang/dsh-dafeiyu-life#readme",
  "bugs": {
    "url": "https://github.com/minedalang/dsh-dafeiyu-life/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "prompts",
    "vendor",
    "README.md",
    "AGENTS.md",
    "selfcheck.mjs",
    "LICENSE",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTORS.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
